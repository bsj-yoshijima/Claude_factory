# ============================================================================
# .env の雛形。コピーして値を埋める:
#     cp env.example .env
#
# npm run dev / npm run db:migrate が自動で読む（node --env-file-if-exists=.env）。
# 何も埋めなければ「ローカル完結」の既定値で動く（docker compose の Postgres + dev ログイン）。
# .env は .gitignore 済み。絶対にコミットしない。
#
# 手順の詳細は docs/phase1-setup.md
#
# ※ ファイル名の先頭にドットが無いのは、.env* が編集をブロックする権限設定に
#    入っているため。中身と使い方は通常の .env.example と同じ。
# ============================================================================


# ============================== DB の向き先 ==============================
# 未設定なら docker compose のローカル Postgres:
#     postgres://factory:factory@localhost:55432/factory
#
# チームで1つの DB を共有する場合だけ、オーナーから渡された接続文字列を入れる。
# Neon の場合、Connection string 画面の「Connection pooling」を OFF にした
# 直接接続版を使う（ホスト名に -pooler が入っていないほう）。
#   ・?sslmode=require は消さない（Neon は TLS 必須）
#   ・&channel_binding=require などが付いていたらそれも残す
#   ・DB 名は neondb のままでよい
DATABASE_URL=

# 1プロセスが握る最大接続数。未設定なら 10。**通常は設定しなくてよい。**
#
# 下げると遅くなる。getState は12本のクエリを投げるので、接続数を絞ると往復が
# 何波にも分かれる。Neon（シンガポール、1往復 約77ms）での実測:
#     未設定(=10) → getState 約390ms
#     3           → getState 約1080ms
#
# 共有 DB でも絞る必要はまず無い。Neon 無料枠の実測値は max_connections=901 で、
# 10人が10接続ずつ持っても 100 にしかならない。
# 下げるのは、DB 側の上限に実際にぶつかったときだけ。
#PG_POOL_MAX=10


# ============================== 公開 URL ==============================
# Cookie の Secure 属性、OAuth のリダイレクト先、/setup が配る OTLP エンドポイントの
# 元になる。ローカルなら両方とも未設定でよい（http://localhost:4321 になる）。
# 4321 が埋まっているときだけ両方セットする（PORT だけ変えると OAuth のリダイレクトが壊れる）。
#PORT=4321
#PUBLIC_URL=http://localhost:4321


# ============================== Google SSO ==============================
# ID と SECRET の両方を設定すると Google SSO が有効になり、
# dev ログイン（メールアドレスを入れるだけ）は自動で無効になる。
# 未設定のあいだは dev ログインで動くので、DB の疎通確認だけ先に済ませられる。
#
# 取得手順:
#   Google Cloud Console → APIとサービス → 認証情報
#     → 認証情報を作成 → OAuth クライアント ID
#   アプリケーションの種類: ウェブアプリケーション
#   承認済みのリダイレクト URI に PUBLIC_URL + /auth/google/callback を登録:
#     ローカル : http://localhost:4321/auth/google/callback
#   （http は通常 Google に拒否されるが、localhost だけは例外で許可されている）
#
# ★ リーダーボードの検証だけなら、この3つは空のままでよい。
#    dev ログインでも同じ共有 DB に入るので、正しく並ぶ。
#    ユーザーはメールアドレスで同定されるため、後から SSO に切り替えても
#    工場と実績はそのまま引き継がれる。
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# 社内ドメイン限定。設定するとアカウント選択画面にこのドメインのものだけが出る。
#GOOGLE_HD=bravesoft.co.jp

# GOOGLE_CLIENT_ID を入れれば dev ログインは自動で無効になるが、
# 本番では明示しておくと安全（設定の投入ミスで dev ログインが開くのを防ぐ）。
#DEV_LOGIN=0


# ======================= 開発用の裏道（?unlockall）=======================
# 画面に ?unlockall を付けると 💰100万・全アイテム・全シリーズが入る。
# dev ログイン中は誰でも使えるが、SSO を設定すると閉じる。そのうえで、
# ここに書いたメールアドレスの人にだけ開けておく。
#
# 触るのは factories の money / stock / 所持品だけで、リーダーボードが読む
# scorecard_daily と wp_daily には一切触れない。つまり順位には影響しない。
#
# カンマ区切り。この行を消してもコード側に同じ既定値が入っているので挙動は変わらない。
# 全員に閉じたいときは、消すのではなく空文字を設定する（DEV_UNLOCK_EMAILS=）。
DEV_UNLOCK_EMAILS=k.hioki@bravesoft.co.jp,k.yoshijima@bravesoft.co.jp,n.konta@bravesoft.co.jp
